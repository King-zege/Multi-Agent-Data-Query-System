# ===== Multi-Agent Data Query System — Environment Variables =====
#
# Setup:
#   1. Copy this file to .env
#   2. Fill in your API keys below
#   3. The .env file is already in .gitignore (will NOT be committed)
#
#   cp .env.example .env   # Linux/Mac
#   copy .env.example .env  # Windows
#

# ===== LLM API (required) =====
# Supported providers (set in config/config.yaml):
#   - minimax   → MiniMax M2 series
#   - dashscope → Alibaba Qwen series
#   - zhipu     → Zhipu GLM series
#
# All use OpenAI-compatible endpoints — just provide your key.
LLM_API_KEY="your_api_key_here"

# ===== Optional: Tavily Web Search =====
# Get a free key at https://tavily.com (1,000 requests/month)
# If left empty, web search features will be disabled gracefully.
TAVILY_API_KEY="your_tavily_key_here"
